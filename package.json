{
  "name": "omni-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify": "npm test && tsc --noEmit && eslint src test e2e --max-warnings=0 && next build && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
