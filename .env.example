# SQLite local (runtime atual). Postgres/Supabase continuam no schema.sql para migração.

OMNI_DB_PATH=./data/omni-crm.sqlite

# Opcional: chave master (exige header X-Org-Id)
MCP_API_KEY=omni_master_demo

# Orgs de demo (seed automático se o banco estiver vazio). Duas credenciais
# por org, com escopos diferentes — nunca a mesma chave para os dois papéis:
#   agent key   -> tools de agente (todo/in_progress/in_review, nunca done)
#   harness key -> só quem fecha done / aprova ICP / aprova copy
# Acme:  omni_org_acme_demo          (agent)   / omni_org_acme_harness_demo (harness)
# Beta:  omni_org_beta_demo          (agent)   / omni_org_beta_harness_demo (harness)

# Postgres / Supabase (ainda não é o runtime padrão)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

EMBEDDING_MODEL=hash-bow-1536
OPENAI_API_KEY=
