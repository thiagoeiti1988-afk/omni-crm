# ─── Runtime ──────────────────────────────────────────────────────────────
OMNI_DB_PATH=./data/omni-crm.sqlite

# Produção: desligue o seed demo e crie a primeira org no primeiro boot.
OMNI_SEED_DEMO=1
# OMNI_BOOTSTRAP_ORG_NAME="Minha Empresa"
# OMNI_BOOTSTRAP_OWNER_EMAIL=dono@empresa.com.br
# OMNI_BOOTSTRAP_OWNER_PASSWORD=troque-por-uma-senha-forte

# Chave do operador da plataforma: provisiona orgs (/api/admin/orgs) e acessa
# qualquer org com X-Org-Id. Nunca entregue a agentes.
MCP_API_KEY=troque-esta-chave-master

# Sessão do painel (horas). Cookie é Secure em produção; só para HTTP local:
# OMNI_INSECURE_COOKIES=1
OMNI_SESSION_TTL_HOURS=168

# ─── Copywriter com Claude (opcional) ─────────────────────────────────────
# Sem chave, a copy usa template determinístico. Sempre passa por Human Review.
ANTHROPIC_API_KEY=
# OMNI_COPY_MODEL=claude-opus-5-5

# ─── WhatsApp Cloud API (opcional) ────────────────────────────────────────
# Webhook: https://SEU_DOMINIO/api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Faturamento por resultado (centavos de BRL) ──────────────────────────
OMNI_BASE_FEE_CENTS=19900
OMNI_PRICE_LEAD_QUALIFIED_CENTS=1500
OMNI_PRICE_COPY_APPROVED_CENTS=900
OMNI_PRICE_DEAL_WON_CENTS=9900

# ─── Demo ─────────────────────────────────────────────────────────────────
# Orgs Acme/Beta e usuários owner|closer|copy@acme.demo, owner@beta.demo.
# OMNI_DEMO_PASSWORD=omni-demo-2026

# Observabilidade: 0 desliga o log JSON por request.
OMNI_LOG=1
